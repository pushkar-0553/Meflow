# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=meflow-secure-dev-session-secret-min-32-chars

# Database Configuration (TiDB Cloud / MySQL)
DB_HOST=127.0.0.1
DB_PORT=4000
DB_USER=root
DB_PASSWORD=
DB_NAME=meflow
DB_SSL=false

# HTTPS Email Service (Brevo Transactional API - Leave empty to use Console Mock Logger)
BREVO_API_KEY=
BREVO_SENDER_NAME=VCube MeFlow
BREVO_SENDER_EMAIL=notifications@vcube.com

# File & Image Storage (Cloudinary - Leave empty to use Direct URL / Mock Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
